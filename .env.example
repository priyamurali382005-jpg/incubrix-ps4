APP_ENV=dev
SIMULATION_MODE=true
DATABASE_URL=sqlite:///./incubrix.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_S=10
DISABLED_CONNECTORS=
MOCK_WEBHOOK_SECRET=demo-secret
JOBS_SYNC=false
JOB_WORKERS=4
MAX_PUBLISH_ATTEMPTS=3
BACKOFF_MAX_S=60
CIRCUIT_BREAKER_THRESHOLD=5
CALLBACK_SECRET=change-me
EVIDENCE_DIR=./evidence
CERT_ALLOWED_HOSTS=localhost,127.0.0.1
CERT_HTTP_CHECK=false

# Real-mode credentials. Set these in your shell, never commit real values:
# CONN_LEMMY={"base_url":"http://localhost:8536","username":"admin","password":"..."}
# CONN_GHOST={"base_url":"http://localhost:2368","admin_key":"<id>:<secret>"}
# Phase 6 API security and rate limiting
API_TOKEN=
RATE_LIMIT_PER_MIN=0
TRUST_PROXY_HEADERS=false

# Phase 6 connectors and data import
MOCK_BASE_URL=
CONN_FILE=
SEED_CSV=

# Phase 6 output storage
PUBLIC_BASE_URL=
STORAGE_BACKEND=local
FILES_DIR=./files
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=incubrix-outputs
S3_REGION=us-east-1
S3_URL_EXPIRES_S=3600
MAX_UPLOAD_BYTES=5000000
ALLOW_PRIVATE_FETCH=false

# Docker demo credentials: configure in the environment, never commit real values
# LEMMY_ADMIN_PASSWORD=
# GHOST_OWNER_EMAIL=
# GHOST_OWNER_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# MINIO_IMAGE=
