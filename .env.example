APP_ENV=dev
SIMULATION_MODE=true
DATABASE_URL=sqlite:///./incubrix.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_S=10
DISABLED_CONNECTORS=
MOCK_WEBHOOK_SECRET=demo-secret
JOBS_SYNC=false
JOB_WORKERS=4
MAX_PUBLISH_ATTEMPTS=3
BACKOFF_MAX_S=60
CIRCUIT_BREAKER_THRESHOLD=5
CALLBACK_SECRET=change-me
EVIDENCE_DIR=./evidence
CERT_ALLOWED_HOSTS=localhost,127.0.0.1
CERT_HTTP_CHECK=false

# Real-mode credentials. Set these in your shell, never commit real values:
# CONN_LEMMY={"base_url":"http://localhost:8536","username":"admin","password":"..."}
# CONN_GHOST={"base_url":"http://localhost:2368","admin_key":"<id>:<secret>"}